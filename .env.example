# AdDroid OSS — example environment variables.
#
# Copy this file to .env (recommended) so that Prisma `db:*` commands, Next.js,
# and the `addroid` CLI all auto-load it from the repo root.
#
#   cp .env.example .env
#
# .env.local also works for the `addroid` CLI and Next.js (and overrides .env),
# but Prisma's CLI does NOT read .env.local — keep DATABASE_URL in .env if you
# want `npm run db:push` / `npm run db:migrate` to pick it up automatically.
#
# Both .env and .env.local are gitignored. Do NOT commit either file.
#
# All values below are placeholders. Never commit real tokens, encryption keys,
# OAuth client secrets, GitHub PATs, Meta access tokens, Slack tokens, or
# OpenAI / Anthropic / Codex API keys to this file. See docs/SECURITY.md for
# the full secret-handling policy.

# PostgreSQL connection string. AdDroid expects PostgreSQL 16 or newer.
# Replace USER and PASSWORD with the role/password you created for AdDroid.
# A complete local-dev recipe (CREATE ROLE / GRANTs / common failures) is in
# docs/TROUBLESHOOTING.md §2 and prisma/README.md.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/addroid

# 32+ byte random string used to encrypt OAuth tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-a-32-byte-random-value

# Optional override for the AdDroid runtime home (defaults to ~/.addroid).
# Used by `addroid init` / `addroid up` for config and storage.
# ADDROID_HOME=.addroid-test-home

# Optional: bind address / port for the local Web UI.
# AdDroid binds to 127.0.0.1 by default. Do not expose this to the public internet.
# ADDROID_WEB_HOSTNAME=127.0.0.1
# ADDROID_WEB_PORT=3000

# Test / development conveniences (never enable in real OSS deployments).
# ADDROID_GITHUB_OAUTH_MOCK=1
# ADDROID_META_ADS_CLI_MOCK=1

# LLM provider selection.
# Recommended for non-engineers: run `addroid auth llm --provider openai`
# or `addroid auth llm --provider anthropic`. The API key is stored encrypted in
# oauth_tokens.access_token_ciphertext; do not keep real API keys in .env.
# ADDROID_LLM_PROVIDER=openai   # optional preference: openai / anthropic / codex

# Codex / OpenAI OAuth client configuration for the LLM provider.
# When all three required values (CLIENT_ID, AUTHORIZATION_URL, TOKEN_URL) plus
# CHAT_COMPLETIONS_URL, DEFAULT_MODEL, and ENCRYPTION_KEY are set, the worker
# selects CodexLLMProvider; otherwise it falls back to StubLLMProvider and AI
# workflows fail-closed without corrupting GitOps state.
# Tokens issued by the OAuth server are stored encrypted via ENCRYPTION_KEY in
# oauth_tokens.access_token_ciphertext — never logged in plaintext.
# ADDROID_CODEX_CLIENT_ID=
# ADDROID_CODEX_AUTHORIZATION_URL=https://auth.openai.com/oauth/authorize
# ADDROID_CODEX_TOKEN_URL=https://auth.openai.com/oauth/token
# ADDROID_CODEX_CHAT_COMPLETIONS_URL=https://api.openai.com/v1/chat/completions
# ADDROID_CODEX_DEFAULT_MODEL=gpt-4.1
# Optional overrides:
# ADDROID_CODEX_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/oauth/codex/callback
# ADDROID_CODEX_SCOPES=openai,offline_access
# ADDROID_CODEX_CLIENT_SECRET=  # leave unset for PKCE (default); set for confidential clients
# ADDROID_LLM_MOCK=1            # dev-only: auto-connect MockLLMProvider in the worker

# Image generation provider selection.
# - If an encrypted OpenAI API key was registered with `addroid auth llm --provider openai`,
#   AdDroid can use it for GPT Image 2 without storing a second key.
# - If Codex OAuth / local app-server mode is selected, image generation can route through
#   `codex app-server` on localhost instead of the OpenAI Images API.
# - Anthropic API keys do not provide GPT Image generation.
# ADDROID_IMAGE_PROVIDER=openai      # optional: openai / codex / mock
# ADDROID_OPENAI_IMAGE_MODEL=gpt-image-2
# ADDROID_OPENAI_IMAGE_QUALITY=medium  # low / medium / high / auto
# ADDROID_CODEX_IMAGE_MODEL=local/codex-image
# ADDROID_CODEX_APP_SERVER_URL=ws://127.0.0.1:4455  # optional external local app-server; normally unset
# ADDROID_CODEX_IMAGE_PARALLEL=5
# ADDROID_IMAGE_MOCK=1               # dev-only: deterministic placeholder PNGs
